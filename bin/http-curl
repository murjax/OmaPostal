#!/usr/bin/env bash
# omarchy:summary=Print a copy-pasteable curl command line for a JSON request file; sends nothing.
# omarchy:args=<request-file>
#
# Request file: same shape http-send accepts (ad-hoc {"method","url","headers",
# "body","timeoutSec"} or group mode {"groupFile","env","path"/"requestName","auth",
# "headers","body","timeoutSec"}). Group mode is resolved exactly like http-send
# (lib/resolve.jq): baseUrl + path, {{vars}}, saved request, auth — all substituted
# and UNMASKED, since the command is meant to actually run in a terminal.
# Output (stdout, one JSON line): {"ok":bool,"curl":"...","error":"..."}
set -uo pipefail

fail() {
  jq -n --arg err "$1" '{ok:false,curl:"",error:$err}'
  exit 0
}

LIB_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)

req=${1:-}
[[ -n $req && -f $req ]] || fail "missing request file"
jq -e . "$req" >/dev/null 2>&1 || fail "invalid request file"

groupFile=$(jq -r '.groupFile // ""' "$req")
if [[ -n $groupFile ]]; then
  [[ -f $groupFile ]] || fail "group file not found: $groupFile"
  jq -e 'type == "object"' "$groupFile" >/dev/null 2>&1 || fail "invalid group file: $groupFile"
  # $req/$group go in via --slurpfile (jq reads the file itself) rather than
  # --argjson "$(<file)", which would put the full request/group JSON —
  # Authorization values, passwords, API keys included — into this jq
  # process's own argv, visible to other local users via `ps`/
  # `/proc/<pid>/cmdline` for as long as it runs.
  resolveOut=$(jq -nc -L "$LIB_DIR" --slurpfile req "$req" --slurpfile group "$groupFile" \
    --arg envName "$(jq -r '.env // ""' "$req")" -f "$LIB_DIR/resolve.jq") \
    || fail "failed to resolve group request"
  jq -e '.ok == true' <<<"$resolveOut" >/dev/null || fail "$(jq -r '.error' <<<"$resolveOut")"
  # Only timeoutSec (a plain number) is needed from the original request here,
  # so extract just that instead of putting the whole request back on argv.
  origTimeoutSec=$(jq -r '(.timeoutSec // 30) | if (type == "number" and . > 0) then . else 30 end' "$req")
  eff=$(jq -c --argjson timeoutSec "$origTimeoutSec" \
    '{method, url, headers, body, timeoutSec: $timeoutSec}' <<<"$resolveOut")
else
  eff=$(jq -c '{method: (.method // "GET"), url: (.url // ""), headers: (.headers // {}),
    body: (.body // ""), timeoutSec: (.timeoutSec // 30)}' "$req")
fi

url=$(jq -r '.url' <<<"$eff")
[[ -n $url ]] || fail "missing url"

curlCmd=$(jq -r <<<"$eff" '
  ["curl", "-sS", "-L", "--max-redirs", "10", "-X", .method,
   "--max-time", (.timeoutSec | tostring), "--connect-timeout", "10"]
  + ((.headers | to_entries | map(["-H", (.key + ": " + (.value | tostring))]) | add) // [])
  + (if (.body // "") != "" then ["--data-binary", .body] else [] end)
  + [.url]
  | @sh
')

# $curlCmd is the resolved, UNMASKED command (that's the whole point of this
# script), so it can carry an Authorization value, password, or API key.
# Written to a temp file and read via --rawfile instead of --arg "$curlCmd"
# so it never sits on this jq process's own argv, even for the moment it
# takes to build the output.
curlCmdFile=$(mktemp)
trap 'rm -f "$curlCmdFile"' EXIT
printf '%s' "$curlCmd" >"$curlCmdFile"
jq -n --rawfile curl "$curlCmdFile" '{ok:true,curl:$curl,error:""}'
